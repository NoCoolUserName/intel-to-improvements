# Local replay needs no credentials. Copy to .env only for optional integrations.
ITI_HOST=127.0.0.1
ITI_PORT=8000
ITI_DATA_DIR=runtime
OPENAI_API_KEY=
OPENAI_MODEL=
# Explicit optional compatible endpoint. No assistant authentication is read.
OPENAI_BASE_URL=
ITI_MAX_MODEL_TOKENS=24000
ITI_MAX_OUTPUT_TOKENS=3000
# Optional operator-supplied USD/token rates, never assumed.
ITI_INPUT_USD_PER_TOKEN=
ITI_OUTPUT_USD_PER_TOKEN=
ITI_MAX_MODEL_USD=1.00
MISP_URL=
MISP_API_KEY=
# TLS verification always enabled. Customer destination must match this URL.
