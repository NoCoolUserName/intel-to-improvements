{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "properties": {
    "synthetic": true,
    "description": "Authored CodeQL-shaped fixture, NOT actual CodeQL scan output"
  },
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL (synthetic fixture)",
          "version": "0.0-demo",
          "rules": [
            {
              "id": "synthetic/example-injection",
              "shortDescription": {
                "text": "Synthetic CWE example; not a real scan"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-079"
                ],
                "security-severity": "7.5"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "synthetic/example-injection",
          "ruleIndex": 0,
          "message": {
            "text": "Synthetic example only: inspect authored location 0"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "synthetic/example0.txt"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "authored-line-0"
          }
        },
        {
          "ruleId": "synthetic/example-injection",
          "ruleIndex": 0,
          "message": {
            "text": "Synthetic example only: inspect authored location 1"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "synthetic/example1.txt"
                },
                "region": {
                  "startLine": 11,
                  "startColumn": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "authored-line-1"
          }
        }
      ]
    }
  ]
}
